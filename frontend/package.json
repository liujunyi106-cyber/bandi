{
  "name": "bandi-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/check-i18n.cjs",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "dev:api": "cd ../bandi && .venv\\Scripts\\python.exe -m uvicorn bandi.api.app:app --host 127.0.0.1 --port 8766",
    "dev:api:reload": "cd ../bandi && .venv\\Scripts\\python.exe -m uvicorn bandi.api.app:app --host 127.0.0.1 --port 8766 --reload",
    "dev:electron": "tsc -p electron/tsconfig.json && wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/electron-runner.cjs .",
    "dev:desktop": "concurrently -k -n vite,api,electron -c cyan,magenta,yellow \"vite\" \"pnpm run dev:api\" \"pnpm run dev:electron\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "3.0.0",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.15",
    "lucide-react": "^0.469.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "recharts": "3.8.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.3.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3-force": "3.0.10",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "electron": "33.3.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.0.4",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
